  "sections": [
    {
      "type": "fill-blank",
      "questions": [
        {
          "id": "q1",
          "grammarId": "n3-w1-d2-g2",
          "prompt": "おなかがすいていたので、一人でピザを二枚も（　　）。",
          "choices": [
            "頼んちゃった",
            "頼みちゃった",
            "頼んじゃった",
            "頼むちゃった"
          ],
          "answerIndex": 2,
          "explanation": "頼む has the て-form 頼んで, and で-verbs contract てしまった to じゃった: 頼んじゃった. ちゃう joins the て-form, never the stem or the dictionary form."
        },
        {
          "id": "q2",
          "grammarId": "n3-w1-d3-g2",
          "prompt": "会社を辞めて、これからはもっと自分（　　）生き方をしようと決めた。",
          "choices": [
            "らしい",
            "らしく",
            "みたい",
            "ような"
          ],
          "answerIndex": 0,
          "explanation": "Nらしい means true to what N really is, and before a noun (生き方) it stays らしい. らしく modifies a verb (自分らしく生きる), and before a noun みたい needs な and ような needs の."
        },
        {
          "id": "q3",
          "grammarId": "n3-w1-d4-g2",
          "prompt": "明日は朝六時に目が（　　）、目覚まし時計を二つかけておいた。",
          "choices": [
            "覚めるために",
            "覚ますために",
            "覚ますように",
            "覚めるように"
          ],
          "answerIndex": 3,
          "explanation": "目が覚める happens by itself, so the goal takes ように. ために needs an action you choose to do, and 覚ます is transitive, so it cannot follow 目が."
        },
        {
          "id": "q4",
          "grammarId": "n3-w1-d5-g2",
          "prompt": "（先生が生徒に）教室を最後に出る人は、電気を（　　）。",
          "choices": [
            "消せるように",
            "消すように",
            "消したように",
            "消してように"
          ],
          "answerIndex": 1,
          "explanation": "A light command from above is Vる＋ように。 and names an action the listener can choose. A potential form (消せる) is not an instruction, and ように never follows the past or the て-form."
        },
        {
          "id": "q5",
          "grammarId": "n3-w2-d2-g1",
          "prompt": "市役所では、ごみの出し方（　　）質問に、電話で答えている。",
          "choices": [
            "に関して",
            "に対して",
            "に関する",
            "による"
          ],
          "answerIndex": 2,
          "explanation": "Before a noun (質問) the form is に関する. に関して modifies a verb, に対して marks a target rather than a topic, and による means caused by or depending on."
        },
        {
          "id": "q6",
          "grammarId": "n3-w2-d3-g3",
          "prompt": "転校していった友達（　　）を、今でもときどき思い出す。",
          "choices": [
            "のこと",
            "について",
            "に関して",
            "こと"
          ],
          "answerIndex": 0,
          "explanation": "Thinking of a person as a whole takes 人のことを: 友達のことを思い出す. について and に関して cannot be followed by を, and after a noun こと needs の."
        },
        {
          "id": "q7",
          "grammarId": "n3-w2-d5-g2",
          "prompt": "「温泉」（　　）、私は子どものころ家族で行った箱根の旅行を思い出す。",
          "choices": [
            "というのは",
            "というと",
            "といっても",
            "について"
          ],
          "answerIndex": 1,
          "explanation": "The word calls up a memory (思い出す), so というと. というのは opens a definition ending in 〜のことだ, といっても concedes and then limits, and について only names a topic."
        },
        {
          "id": "q8",
          "grammarId": "n3-w3-d2-g4",
          "prompt": "この仕事が毎日こんなに大変（　　）、長く続けられる自信がない。",
          "choices": [
            "としたら",
            "なとしたら",
            "にしては",
            "だとしたら"
          ],
          "answerIndex": 3,
          "explanation": "としたら keeps だ after な-adjectives and nouns: 大変だとしたら. Dropping だ or using な is wrong, and にしては (for a …) has the wrong meaning."
        },
        {
          "id": "q9",
          "grammarId": "n3-w3-d3-g3",
          "prompt": "人から聞いた秘密は、本人に断らずにほかの人に（　　）。",
          "choices": [
            "話さないべきだ",
            "話すべきではない",
            "話しべきではない",
            "話すべきだった"
          ],
          "answerIndex": 1,
          "explanation": "べき follows only the dictionary form, so the negative goes on べき: 話すべきではない. 話さないべきだ and 話しべき break that rule, and 話すべきだった says the opposite."
        },
        {
          "id": "q10",
          "grammarId": "n3-w4-d2-g2",
          "prompt": "昨日の夜、辛いものを食べすぎた（　　）、今朝からおなかの調子が悪い。",
          "choices": [
            "せいで",
            "おかげで",
            "くせに",
            "わりに"
          ],
          "answerIndex": 0,
          "explanation": "A cause that led to a bad result for the speaker: せいで. おかげで is for good results, くせに needs a person as its subject, and わりに compares with what you would expect."
        },
        {
          "id": "q11",
          "grammarId": "n3-w4-d3-g1",
          "prompt": "毎日同じクラスなんだから、私の名前（　　）覚えてくれてもいいのに。",
          "choices": [
            "ほど",
            "ばかり",
            "くらい",
            "しか"
          ],
          "answerIndex": 2,
          "explanation": "\"At least this much\" is くらい's own use: 名前くらい覚えて. ほど cannot mean the bare minimum, ばかり means nothing but, and しか needs a negative verb."
        },
        {
          "id": "q12",
          "grammarId": "n3-w4-d4-g3",
          "prompt": "（先輩が後輩に）初めての海外旅行なら、大事なものを全部一つのかばんに入れない（　　）。",
          "choices": [
            "ことにする",
            "わけだ",
            "べきだ",
            "ことだ"
          ],
          "answerIndex": 3,
          "explanation": "Someone experienced giving advice uses Vない＋ことだ. ことにする is the speaker's own decision, わけだ means no wonder, and べき cannot follow a ない-form."
        },
        {
          "id": "q13",
          "grammarId": "n3-w5-d3-g1",
          "prompt": "夏休みが終わるまでに、私も二十五メートル（　　）といいなあ。",
          "choices": [
            "泳ぐ",
            "泳げる",
            "泳げた",
            "泳いで"
          ],
          "answerIndex": 1,
          "explanation": "A wish about your own (私も) ability takes the potential: 泳げるといいなあ. Plain 泳ぐといい sounds like advice, a wish about the future stays non-past, and と cannot follow the て-form."
        },
        {
          "id": "q14",
          "grammarId": "n3-w5-d6-g4",
          "prompt": "この紅茶、いい香りだね。（　　）、山田さんの赤ちゃん、もう生まれた？",
          "choices": [
            "ところが",
            "それとも",
            "ところで",
            "つまり"
          ],
          "answerIndex": 2,
          "explanation": "The speaker jumps to an unrelated topic, so ところで. ところが brings an unexpected result, それとも offers a choice between two questions, and つまり restates."
        },
        {
          "id": "q15",
          "grammarId": "n3-w6-d1-g3",
          "prompt": "（　　）の時は、となりの家の人に頼んであるから大丈夫だよ。",
          "choices": [
            "もし",
            "もしかして",
            "仮に",
            "もしも"
          ],
          "answerIndex": 3,
          "explanation": "もしもの時 (the worst case) is a fixed noun, and only もしも can take の this way. もし, もしかして and 仮に are adverbs and cannot be followed by の."
        }
      ]
    },
    {
      "type": "sentence-order",
      "questions": [
        {
          "id": "q16",
          "grammarId": "n3-w1-d1-g2",
          "before": "飛行機の中で、",
          "after": "ほとんど眠れなかった。",
          "pieces": [
            "子どもに",
            "泣かれて",
            "座った",
            "後ろの席に"
          ],
          "correctOrder": [
            3,
            2,
            0,
            1
          ],
          "starSlot": 3,
          "explanation": "後ろの席に座った子どもに泣かれて: the one who caused the trouble takes に, right before the passive 泣かれて. 座った modifies 子ども, so ★ 子どもに is third."
        },
        {
          "id": "q17",
          "grammarId": "n3-w1-d6-g2",
          "before": "ベッドに",
          "after": "、外で大きな音がした。",
          "pieces": [
            "とき",
            "とした",
            "寝よう",
            "入って"
          ],
          "correctOrder": [
            3,
            2,
            1,
            0
          ],
          "starSlot": 3,
          "explanation": "入って寝ようとしたとき: the volitional 寝よう takes とする, and とき follows it for \"just as I was about to\". So ★ とした is third."
        },
        {
          "id": "q18",
          "grammarId": "n3-w2-d1-g2",
          "before": "この店のケーキは人気があるのに、一日に",
          "after": "そうだ。",
          "pieces": [
            "作ら",
            "だけしか",
            "ない",
            "二十個"
          ],
          "correctOrder": [
            3,
            1,
            0,
            2
          ],
          "starSlot": 4,
          "explanation": "二十個だけしか作らない: だけしか follows the number, and the frame must end in a negative verb. So ★ ない closes the four slots."
        },
        {
          "id": "q19",
          "grammarId": "n3-w2-d6-g2",
          "before": "妹に、帰りにコンビニで",
          "after": "頼まれた。",
          "pieces": [
            "ように",
            "買って",
            "アイスを",
            "くる"
          ],
          "correctOrder": [
            2,
            1,
            3,
            0
          ],
          "starSlot": 3,
          "explanation": "アイスを買ってくるように頼まれた: ように言う／頼む takes a dictionary form, never a て-form, so くる must stand between 買って and ように. ★ くる is third."
        },
        {
          "id": "q20",
          "grammarId": "n3-w3-d2-g1",
          "before": "姉は、",
          "after": "夜は大学で勉強している。",
          "pieces": [
            "として",
            "ながら",
            "働き",
            "看護師"
          ],
          "correctOrder": [
            3,
            0,
            2,
            1
          ],
          "starSlot": 2,
          "explanation": "看護師として働きながら: として follows the noun that names the role. ながら joins 働き, so ★ として is second."
        },
        {
          "id": "q21",
          "grammarId": "n3-w3-d4-g2",
          "before": "雨が",
          "after": "大きな水たまりができる。",
          "pieces": [
            "道に",
            "家の前の",
            "たびに",
            "降る"
          ],
          "correctOrder": [
            3,
            2,
            1,
            0
          ],
          "starSlot": 2,
          "explanation": "雨が降るたびに家の前の道に: たびに follows the dictionary form 降る, and 家の前の must sit right before 道に. So ★ たびに is second."
        },
        {
          "id": "q22",
          "grammarId": "n3-w3-d5-g1",
          "before": "煮物は、祖母に",
          "after": "いちばんおいしい。",
          "pieces": [
            "のが",
            "とおりに",
            "作る",
            "習った"
          ],
          "correctOrder": [
            3,
            1,
            2,
            0
          ],
          "starSlot": 2,
          "explanation": "祖母に習ったとおりに作るのが: とおりに follows the past form 習った and describes how you make it. So ★ とおりに is second."
        },
        {
          "id": "q23",
          "grammarId": "n3-w3-d5-g4",
          "before": "週末は家族が旅行に出かけたので、",
