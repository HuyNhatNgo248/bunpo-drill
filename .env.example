# Copy to .env and fill in.

# Database. Without these two, the app uses a local database at data/bunpo.db.
# Turso database URL: `turso db show <database> --url`, or "Connect" on the database page.
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io

# Turso auth token: `turso db tokens create <database>`, or "Create token" on the database page.
# TURSO_AUTH_TOKEN=

# Login. The app won't serve pages until both are set.
# Signs the login cookie. Any long random string: `openssl rand -hex 32`. Changing it signs you out.
# SESSION_SECRET=
# Lets the quiz skill (post.sh, tests.sh) call /api without signing in: `openssl rand -hex 32`.
# BUNPO_API_TOKEN=

# Forgot password. The reset email links to APP_URL, so set it to the address people open the app at.
# APP_URL=https://bunpo.huyngo248-dev.org
# Emails go out through Resend (resend.com): verify your domain there, then create an API key.
# Without the key, `pnpm dev` prints each email to the server log instead; `pnpm start` needs it.
# RESEND_API_KEY=
# The sender, on the domain Resend verified.
# MAIL_FROM=文法ドリル <noreply@huyngo248-dev.org>
